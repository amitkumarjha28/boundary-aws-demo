#!/bin/bash
set -euxo pipefail

echo "===> Initializing Boundary Ingress Worker setup..."

# Install dependencies
dnf install -y yum-utils jq nc

# Install HashiCorp Boundary
dnf config-manager --add-repo https://rpm.releases.hashicorp.com/AmazonLinux/hashicorp.repo || true
if ! dnf install -y boundary; then
  echo "Installing boundary directly from official binary release..."
  BOUNDARY_VER="${boundary_version}"
  curl -fsSL "https://releases.hashicorp.com/boundary/$${BOUNDARY_VER}/boundary_$${BOUNDARY_VER}_linux_amd64.zip" -o /tmp/boundary.zip
  unzip -o /tmp/boundary.zip -d /usr/bin/
  chmod +x /usr/bin/boundary
fi

# Create dedicated boundary system user
useradd --system --user-group boundary || true

# Prepare directories
mkdir -p /etc/boundary.d /var/log/boundary
chown -R boundary:boundary /etc/boundary.d /var/log/boundary
chmod 750 /etc/boundary.d /var/log/boundary

# Fetch EC2 Public and Private IP using IMDSv2
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" || true)
PUBLIC_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4 || true)
PRIVATE_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4 || true)

if [ -z "$PUBLIC_IP" ]; then
  PUBLIC_IP="$PRIVATE_IP"
fi

echo "Ingress Worker detected Public IP: $PUBLIC_IP, Private IP: $PRIVATE_IP"

# Wait for Controller cluster port (9201) to become active
echo "===> Waiting for Controller at ${controller_private_ip}:9201..."
for i in {1..60}; do
  if nc -z "${controller_private_ip}" 9201; then
    echo "Boundary Controller cluster port is reachable!"
    break
  fi
  echo "Waiting for controller ($i/60)..."
  sleep 5
done

# Write Boundary Ingress Worker configuration
cat << EOF > /etc/boundary.d/ingress-worker.hcl
disable_mlock = true

worker {
  name        = "boundary-ingress-worker-1"
  description = "Boundary Public Ingress Worker"
  public_addr = "$PUBLIC_IP"
  tags {
    type = ["ingress", "public"]
  }
  controllers = [
    "${controller_private_ip}:9201"
  ]
}

listener "tcp" {
  address     = "0.0.0.0:9202"
  purpose     = "proxy"
  tls_disable = true
}

# Ops listener: /health and Prometheus /metrics (scraped by the ops instance)
listener "tcp" {
  address     = "0.0.0.0:9203"
  purpose     = "ops"
  tls_disable = true
}

kms "aead" {
  purpose   = "worker-auth"
  aead_type = "aes-gcm"
  key       = "${worker_auth_kms_key}"
  key_id    = "global_worker_auth"
}
EOF

chown boundary:boundary /etc/boundary.d/ingress-worker.hcl
chmod 640 /etc/boundary.d/ingress-worker.hcl

# Create systemd service unit for Boundary Ingress Worker
cat << 'EOF' > /etc/systemd/system/boundary-worker.service
[Unit]
Description=HashiCorp Boundary Ingress Worker
Documentation=https://www.boundaryproject.io/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boundary
Group=boundary
ExecStart=/usr/bin/boundary server -config /etc/boundary.d/ingress-worker.hcl
ExecReload=/bin/kill --signal HUP $MAINPID
KillMode=process
KillSignal=SIGINT
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

# Reload and start service
systemctl daemon-reload
systemctl enable boundary-worker
systemctl start boundary-worker

echo "===> Boundary Ingress Worker started successfully!"
