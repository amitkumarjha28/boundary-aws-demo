#!/bin/bash
set -euxo pipefail

# NAT instance for the private subnet (Amazon Linux 2023).
# Uses nftables directly: AL2023 has no `service` command, so the previous
# iptables-services approach aborted before NAT was persisted.

# Enable IP forwarding (persistent)
echo "net.ipv4.ip_forward = 1" > /etc/sysctl.d/90-nat.conf
sysctl -p /etc/sysctl.d/90-nat.conf

dnf install -y nftables

# Masquerade everything leaving the primary interface
IFACE=$(ip route show default | awk '{print $5; exit}')
cat << EOF > /etc/sysconfig/nftables.conf
flush ruleset
table ip nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "$IFACE" masquerade
  }
}
EOF

systemctl enable nftables
systemctl restart nftables
nft list ruleset

echo "NAT instance configured on interface $IFACE"
