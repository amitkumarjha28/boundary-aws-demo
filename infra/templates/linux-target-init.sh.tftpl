#!/bin/bash
set -euxo pipefail

echo "===> Initializing Linux Target (SSH & Internal Web Portal)..."

# 1. Setup Demo User for Boundary SSH Target
USER_NAME="boundary-user"
USER_PASS="${linux_ssh_password}"

useradd -m -s /bin/bash "$USER_NAME" || true
echo "$USER_NAME:$USER_PASS" | chpasswd
usermod -aG wheel "$USER_NAME" || true

# Configure SSH daemon to permit password auth for demo purposes
sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config.d/*.conf 2>/dev/null || true
systemctl restart sshd

# 2. Setup Internal Web Portal on port 8080 (Web Target)
mkdir -p /opt/internal-portal

cat << 'EOF' > /opt/internal-portal/index.html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Corporate Internal Portal | Secured by HashiCorp Boundary</title>
  <style>
    :root {
      --bg: #0d1117;
      --card-bg: rgba(22, 27, 34, 0.85);
      --border: rgba(255, 255, 255, 0.12);
      --primary: #f2545b;
      --accent: #58a6ff;
      --success: #3fb950;
      --text: #f0f6fc;
      --muted: #8b949e;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: linear-gradient(135deg, #090d16 0%, #111827 50%, #1f2937 100%);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .container {
      max-width: 800px;
      width: 100%;
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 40px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 9999px;
      background: rgba(63, 185, 80, 0.15);
      color: var(--success);
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 20px;
      border: 1px solid rgba(63, 185, 80, 0.3);
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 10px var(--success);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.3); opacity: 1; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    h1 {
      font-size: 32px;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin-bottom: 12px;
      background: linear-gradient(90deg, #ffffff, #a5b4fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    p.lead {
      color: var(--muted);
      font-size: 16px;
      line-height: 1.6;
      margin-bottom: 32px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }
    .card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
    }
    .card-title {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .card-value {
      font-size: 18px;
      font-weight: 600;
      color: var(--text);
    }
    .footer {
      border-top: 1px solid var(--border);
      padding-top: 20px;
      font-size: 13px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .hashi-tag {
      font-weight: 600;
      color: #e53e3e;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="badge">
      <span class="pulse-dot"></span>
      Zero-Trust Session Active
    </div>
    <h1>Internal Mission-Critical App</h1>
    <p class="lead">
      You are connected to an isolated private backend server residing inside an air-gapped private subnet. This connection was brokered and authorized end-to-end via <strong>HashiCorp Boundary Multi-Hop Architecture</strong> without any public IP or open ingress.
    </p>

    <div class="grid">
      <div class="card">
        <div class="card-title">Network Location</div>
        <div class="card-value">Private Subnet (Isolated)</div>
      </div>
      <div class="card">
        <div class="card-title">Access Route</div>
        <div class="card-value">Ingress &rarr; Egress Worker</div>
      </div>
      <div class="card">
        <div class="card-title">Session State</div>
        <div class="card-value" style="color: var(--success);">Authorized &amp; Audited</div>
      </div>
    </div>

    <div class="footer">
      <div>HashiCorp Boundary Demo Target</div>
      <div>HTTP Port: <span class="hashi-tag">8080</span></div>
    </div>
  </div>
</body>
</html>
EOF

# Install python3 to serve portal via robust built-in http server
dnf install -y python3

cat << 'EOF' > /etc/systemd/system/internal-portal.service
[Unit]
Description=Internal Corporate Portal HTTP Target
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/internal-portal
ExecStart=/usr/bin/python3 -m http.server 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable internal-portal
systemctl start internal-portal

echo "===> Linux Target & Internal Portal configured successfully!"
